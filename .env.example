# Copie este ficheiro para .env e adicione a sua chave Gemini.
GEMINI_API_KEY=
# AI_API_KEY continua suportada para configurações existentes.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.1-flash-lite

# Opcional: porta HTTP (predefinição: 3000).
PORT=3000
# Desenvolvimento local; em produção o servidor usa 0.0.0.0.
HOST=127.0.0.1

# Diretório para o SQLite (Render com disco persistente: /var/data).
DATA_DIR=.data
