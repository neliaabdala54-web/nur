# Copie este ficheiro para .env e adicione a sua chave Gemini.
GEMINI_API_KEY=
# AI_API_KEY continua suportada para configurações existentes.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.1-flash-lite

# Pesquisa web opcional via Tavily Search API.
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search

# Opcional: porta HTTP (predefinição: 3000).
PORT=3000
# Para acesso em rede, use um proxy HTTPS e configure HOST apenas se necessário.
HOST=127.0.0.1

# Opcional: diretório para o SQLite (predefinição: .data/).
DATA_DIR=.data
